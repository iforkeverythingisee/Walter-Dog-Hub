      <div class="status-row">
        <span class="status-label">Source</span>
        <span class="status-value status-neutral">GitHub Raw</span>
      </div>
      <div class="status-divider"></div>
      <div class="status-row">
        <span class="status-label">Cache</span>
        <span class="status-value status-neutral">Bypassed</span>
      </div>
    </div>

    <!-- Launch Button -->
    <div class="btn-wrapper" style="width:100%;">
      <div class="btn-aura"></div>
      <button class="launch-btn" onclick="openSite()">
        <!-- Rocket icon -->
        <svg viewBox="0 0 24 24">
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
          <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
          <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
          <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
