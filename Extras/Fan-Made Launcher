  <!-- ══════════ MAIN CONTENT ══════════ -->
  <main class="launcher">

    <!-- Mascot -->
    <div class="mascot-container">
      <div class="mascot-ring">
        <span class="mascot-emoji">🐕</span>
      </div>
    </div>

