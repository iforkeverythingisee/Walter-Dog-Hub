  </main>

  <script>
    const RAW_HUB_URL = 'https://raw.githubusercontent.com/iforkeverythingisee/Walter-Dog-Hub/refs/heads/main/Hub.html';

    // Allow pressing Enter to launch
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') openSite();
    });

    async function openSite() {
      const btn = document.querySelector('.launch-btn');
      const originalHTML = btn.innerHTML;

      // Immediately open a blank tab (avoids popup blocker)
      const win = window.open('about:blank', '_blank');
      if (!win) {
        alert('Pop-up blocked! Please allow pop-ups to launch the Hub.');
        return;
      }

      // Update button state
      btn.style.pointerEvents = 'none';
      btn.innerHTML = `
        <svg viewBox="0 0 24 24" style="width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;animation:spin 0.7s linear infinite;">
          <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
        </svg>
        Launching…
      `;

      // Styled loading screen in the new tab
      win.document.write(`<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Loading Walter Dog Hub…</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#06060b;font-family:system-ui,sans-serif;color:#fff}
  .ring{width:48px;height:48px;border:3px solid rgba(99,102,241,0.15);border-top-color:#818cf8;border-radius:50%;animation:spin 0.7s linear infinite;margin-bottom:20px}
  @keyframes spin{to{transform:rotate(360deg)}}
  .msg{color:#818cf8;font-size:15px;font-weight:600;letter-spacing:0.04em}
  .sub{color:#3a3d4a;font-size:12px;margin-top:8px}
  .bar-track{width:200px;height:3px;background:rgba(99,102,241,0.1);border-radius:3px;margin-top:24px;overflow:hidden}
  .bar-fill{height:100%;width:30%;background:linear-gradient(90deg,#6366f1,#8b5cf6);border-radius:3px;animation:load 1.5s ease-in-out infinite}
  @keyframes load{0%{width:10%;margin-left:0}50%{width:60%;margin-left:20%}100%{width:10%;margin-left:90%}}
</style></head>
<body>
  <div class="ring"></div>
  <div class="msg">Loading Hub…</div>
  <div class="sub">Fetching latest version</div>
  <div class="bar-track"><div class="bar-fill"></div></div>
</body></html>`);

      try {
        const response = await fetch(RAW_HUB_URL + '?v=' + Date.now());
        if (!response.ok) throw new Error('Fetch failed');
        const content = await response.text();

        win.document.open();
        win.document.write(content);
        win.document.close();

        // Success state on button
        btn.innerHTML = `
          <svg viewBox="0 0 24 24" style="width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Launched!
        `;
        btn.style.background = 'linear-gradient(135deg, #22c55e, #16a34a)';
        btn.style.boxShadow = '0 6px 24px rgba(34,197,94,0.35), 0 2px 6px rgba(0,0,0,0.3)';

        setTimeout(function() {
          btn.innerHTML = originalHTML;
          btn.style.pointerEvents = '';
          btn.style.background = '';
          btn.style.boxShadow = '';
        }, 2000);

      } catch (err) {
        // Error in the popup
        win.document.open();
        win.document.write(`<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Error</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#06060b;font-family:system-ui,sans-serif;color:#fff}
  .icon{font-size:40px;margin-bottom:16px}
  .msg{color:#ef4444;font-size:17px;font-weight:700}
  .sub{color:#4a4d5a;font-size:13px;margin-top:8px;max-width:300px;text-align:center;line-height:1.5}
</style></head>
